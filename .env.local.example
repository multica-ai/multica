# Local Docker stack configuration.
# scripts/local-stack.sh and scripts/local-stack.ps1 copy this file to
# .env.local and replace the placeholder secrets on first start.

# Host bindings. The stack publishes only to loopback by default.
FRONTEND_PORT=3000
BACKEND_PORT=8080
MAILPIT_UI_PORT=8025
OLLAMA_PORT=11434

# PostgreSQL
POSTGRES_DB=multica
POSTGRES_USER=multica
POSTGRES_PASSWORD=replace-with-a-random-postgres-password

# Application secrets
JWT_SECRET=replace-with-a-random-jwt-secret
MULTICA_VCS_SECRET_KEY=replace-with-a-random-base64-key

# Local access controls
ALLOW_SIGNUP=true
ALLOWED_EMAILS=
ALLOWED_EMAIL_DOMAINS=
DISABLE_WORKSPACE_CREATION=

# Email delivery. Mailpit is the default and keeps all messages local.
# To send through Resend, set RESEND_API_KEY and a verified sender address,
# then leave SMTP_HOST empty. SMTP takes priority whenever SMTP_HOST is set.
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@multica.local
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@multica.local
SMTP_TLS=
SMTP_TLS_INSECURE=false
SMTP_EHLO_NAME=multica.local

# Optional local model used by docker-compose.local-ai.yml.
OLLAMA_MODEL=qwen3:4b

# Image/build metadata
VERSION=local
COMMIT=local
DATE=local
