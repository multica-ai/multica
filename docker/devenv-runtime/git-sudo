#!/usr/bin/env sh
# =============================================================================
# git-sudo — Temporarily elevate GitHub token for a single command
# =============================================================================
#
# The container normally runs with a low-privilege GITHUB_TOKEN (e.g., read-only
# or contents:write on specific repos). Some operations — creating PRs, managing
# releases, writing to protected branches — require broader scopes.
#
# git-sudo swaps GITHUB_TOKEN and GH_TOKEN to the elevated token for exactly
# one command, then reverts. The elevated token is never persisted in git config.
#
# Usage:
#   git-sudo gh pr create --title "..."     # uses elevated token
#   git-sudo git push origin main           # uses elevated token
#   git-sudo gh release create v1.0.0       # uses elevated token
#
# Environment:
#   GITHUB_TOKEN_ELEVATED   — The higher-privilege PAT (required)
#   GITHUB_TOKEN            — The default low-privilege PAT (restored after)
#   GIT_SUDO_LOG            — Set to "1" to enable audit logging (default: 1)
#   GIT_SUDO_LOG_FILE       — Log file path (default: ~/.local/share/git-sudo/audit.log)
#
# Token sources (checked in order):
#   1. GITHUB_TOKEN_ELEVATED environment variable
#   2. ~/.config/git-sudo/elevated-token file (chmod 600)
#
# Security:
#   - Elevated token is NEVER written to git config or gh auth state
#   - Elevated token is passed via environment only (no CLI args)
#   - All invocations are logged to an audit file by default
#   - The command runs in a subshell — parent env is never mutated
#
# =============================================================================
set -eu

# ── Resolve elevated token ──────────────────────────────────────────────────
ELEVATED_TOKEN="${GITHUB_TOKEN_ELEVATED:-}"

if [ -z "${ELEVATED_TOKEN}" ]; then
  TOKEN_FILE="${HOME}/.config/git-sudo/elevated-token"
  if [ -f "${TOKEN_FILE}" ]; then
    ELEVATED_TOKEN="$(cat "${TOKEN_FILE}")"
  fi
fi

if [ -z "${ELEVATED_TOKEN}" ]; then
  echo "git-sudo: no elevated token found." >&2
  echo "" >&2
  echo "Set GITHUB_TOKEN_ELEVATED or create ~/.config/git-sudo/elevated-token" >&2
  echo "" >&2
  echo "Example:" >&2
  echo "  export GITHUB_TOKEN_ELEVATED=ghp_YourElevatedToken" >&2
  echo "" >&2
  echo "Or:" >&2
  echo "  mkdir -p ~/.config/git-sudo" >&2
  echo "  echo 'ghp_YourElevatedToken' > ~/.config/git-sudo/elevated-token" >&2
  echo "  chmod 600 ~/.config/git-sudo/elevated-token" >&2
  exit 1
fi

if [ $# -eq 0 ]; then
  echo "git-sudo: no command specified." >&2
  echo "Usage: git-sudo <command> [args...]" >&2
  exit 1
fi

# ── Audit log ────────────────────────────────────────────────────────────────
GIT_SUDO_LOG="${GIT_SUDO_LOG:-1}"
GIT_SUDO_LOG_FILE="${GIT_SUDO_LOG_FILE:-${HOME}/.local/share/git-sudo/audit.log}"

if [ "${GIT_SUDO_LOG}" = "1" ]; then
  LOG_DIR="$(dirname "${GIT_SUDO_LOG_FILE}")"
  mkdir -p "${LOG_DIR}" 2>/dev/null || true

  TIMESTAMP="$(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null || date '+%Y-%m-%dT%H:%M:%S')"
  # Mask the token — show first 4 and last 4 chars
  TOKEN_LEN=${#ELEVATED_TOKEN}
  if [ "${TOKEN_LEN}" -gt 8 ]; then
    MASK_PREFIX="$(echo "${ELEVATED_TOKEN}" | cut -c1-4)"
    MASK_SUFFIX="$(echo "${ELEVATED_TOKEN}" | cut -c$((TOKEN_LEN - 3))-${TOKEN_LEN})"
    TOKEN_MASKED="${MASK_PREFIX}...${MASK_SUFFIX}"
  else
    TOKEN_MASKED="****"
  fi

  echo "${TIMESTAMP} | token=${TOKEN_MASKED} | cmd=$*" >> "${GIT_SUDO_LOG_FILE}" 2>/dev/null || true
fi

# ── Execute with elevated token ──────────────────────────────────────────────
# Export both GITHUB_TOKEN and GH_TOKEN so both git (via credential helper) and
# gh CLI pick up the elevated token. Run in a subshell so the parent process
# environment is never modified.
#
# We also set up a temporary git credential helper that uses the elevated token
# for github.com URLs, overriding whatever the default helper provides.
export GITHUB_TOKEN="${ELEVATED_TOKEN}"
export GH_TOKEN="${ELEVATED_TOKEN}"

exec "$@"
