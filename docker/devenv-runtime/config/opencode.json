{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["oh-my-openagent@latest"],
  "provider": {
    "litellm": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "LiteLLM",
      "options": {
        "baseURL": "https://llmproxy.g2.com/v1"
      },
      "models": {
        "claude-opus-4-8": {
          "name": "Claude Opus 4.8",
          "id": "anthropic/claude-opus-4-8",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "claude-sonnet-4-8": {
          "name": "Claude Sonnet 4.8",
          "id": "anthropic/claude-sonnet-4-8",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "claude-haiku-4-5": {
          "name": "Claude Haiku 4.5",
          "id": "anthropic/claude-haiku-4-5",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gpt-5.4": {
          "name": "GPT-5.4",
          "id": "openai/gpt-5.4",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gpt-5.3-codex": {
          "name": "GPT-5.3 Codex",
          "id": "openai/gpt-5.3-codex"
        },
        "gpt-5.2": {
          "name": "GPT-5.2",
          "id": "openai/gpt-5.2",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "gpt-5.4-mini": {
          "name": "GPT-5.4 Mini",
          "id": "openai/gpt-5.4-mini",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "vertex-gemini-3.1-pro-preview": {
          "name": "Gemini 3.1 Pro (Vertex)",
          "id": "vertex_ai/gemini-3.1-pro-preview",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "vertex-gemini-3.1-flash-lite-preview": {
          "name": "Gemini 3.1 Flash Lite (Vertex)",
          "id": "vertex_ai/gemini-3.1-flash-lite-preview",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "vertex-gemini-2.5-pro": {
          "name": "Gemini 2.5 Pro (Vertex)",
          "id": "vertex_ai/gemini-2.5-pro",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "vertex-gemini-2.5-flash": {
          "name": "Gemini 2.5 Flash (Vertex)",
          "id": "vertex_ai/gemini-2.5-flash",
          "modalities": { "input": ["text", "image"], "output": ["text"] }
        },
        "vertex-deepseek-v3.2": {
          "name": "DeepSeek V3.2 (Vertex)",
          "id": "vertex_ai/deepseek-ai/deepseek-v3.2-maas"
        },
        "vertex-deepseek-r1": {
          "name": "DeepSeek R1 (Vertex)",
          "id": "vertex_ai/deepseek-ai/deepseek-r1-0528-maas"
        }
      }
    }
  },
  "mcp": {
    "newrelic": {
      "type": "remote",
      "url": "https://mcp.newrelic.com/mcp/",
      "oauth": false,
      "headers": {
        "Api-Key": "{env:NEWRELIC_API_KEY}"
      }
    },
    "metabase": {
      "type": "local",
      "command": ["npx", "@cognitionai/metabase-mcp-server", "--all"],
      "environment": {
        "METABASE_URL": "{env:METABASE_URL}",
        "METABASE_API_KEY": "{env:METABASE_API_KEY}"
      }
    },
    "amplitude": {
      "type": "remote",
      "url": "https://mcp.amplitude.com/mcp"
    },
    "coolify": {
      "type": "local",
      "command": ["npx", "-y", "@ofeser/coolify-mcp"],
      "environment": {
        "COOLIFY_API_URL": "{env:COOLIFY_API_URL}",
        "COOLIFY_API_TOKEN": "{env:COOLIFY_API_TOKEN}"
      }
    },
    "coralogix": {
      "type": "remote",
      "url": "https://api.us1.coralogix.com/mgmt/api/v1/mcp",
      "oauth": false,
      "headers": {
        "Authorization": "{env:CORALOGIX_API_KEY}"
      }
    }
  },
  "permission": {
    "bash": {
      "*": "allow",
      "git push* main": "deny",
      "git push* master": "deny",
      "gh pr merge*--admin*": "deny",
      "gh pr merge*": "deny"
    }
  }
}
