{
  "$schema": "https://raw.githubusercontent.com/code-yeongyu/oh-my-openagent/dev/assets/oh-my-opencode.schema.json",
  "agents": {
    "sisyphus": { "model": "litellm/claude-opus-4-8", "variant": "max" },
    "hephaestus": { "model": "litellm/gpt-5.3-codex", "variant": "medium" },
    "oracle": { "model": "litellm/gpt-5.4", "variant": "high" },
    "librarian": { "model": "litellm/vertex-gemini-3.1-flash-lite-preview" },
    "explore": { "model": "litellm/vertex-gemini-3.1-flash-lite-preview" },
    "multimodal-looker": { "model": "litellm/gpt-5.4-mini" },
    "prometheus": { "model": "litellm/vertex-gemini-3.1-pro-preview", "variant": "max" },
    "metis": { "model": "litellm/vertex-gemini-3.1-pro-preview", "variant": "max" },
    "momus": { "model": "litellm/vertex-deepseek-r1", "variant": "medium" },
    "atlas": { "model": "litellm/claude-sonnet-4-8" },
    "sisyphus-junior": { "model": "opencode/gpt-5-nano" }
  },
  "categories": {
    "visual-engineering": { "model": "litellm/vertex-gemini-3.1-pro-preview" },
    "ultrabrain": { "model": "litellm/gpt-5.4", "variant": "xhigh" },
    "deep": { "model": "litellm/gpt-5.3-codex", "variant": "medium" },
    "artistry": { "model": "litellm/claude-opus-4-8", "variant": "max" },
    "quick": { "model": "litellm/gpt-5.4-mini" },
    "unspecified-low": { "model": "litellm/vertex-gemini-2.5-flash" },
    "unspecified-high": { "model": "litellm/vertex-gemini-3.1-pro-preview" },
    "writing": { "model": "litellm/vertex-deepseek-v3.2" }
  },
  "sisyphus_agent": {
    "default_builder_enabled": true
  },
  "background_task": {
    "providerConcurrency": { "litellm": 10 },
    "modelConcurrency": {
      "litellm/claude-opus-4-8": 2,
      "litellm/claude-sonnet-4-8": 5,
      "litellm/claude-haiku-4-5": 20,
      "litellm/gpt-5.4": 3,
      "litellm/gpt-5.4-mini": 10,
      "litellm/gpt-5.3-codex": 3,
      "litellm/gpt-5.2": 3,
      "litellm/vertex-gemini-3.1-pro-preview": 5,
      "litellm/vertex-gemini-3.1-flash-lite-preview": 20,
      "litellm/vertex-gemini-2.5-pro": 5,
      "litellm/vertex-gemini-2.5-flash": 10,
      "litellm/vertex-deepseek-v3.2": 5,
      "litellm/vertex-deepseek-r1": 3
    }
  },
  "team_mode": {
    "enabled": true,
    "max_parallel_members": 4,
    "max_members": 8,
    "tmux_visualization": true
  },
  "tmux": { "enabled": false },
  "disabled_hooks": ["startup-toast", "auto-update-checker"]
}
