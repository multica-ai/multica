#!/bin/sh
set -eu

WORKSPACES="${HOME}/workspaces"
AUTH_DIR="${HOME}/.local/share/opencode"
ENV_FILE="${WORKSPACES}/.opencode-env"

EXISTING_LITELLM_API_KEY=""
EXISTING_GITHUB_TOKEN=""
EXISTING_GIT_USER_NAME=""
EXISTING_GIT_USER_EMAIL=""
EXISTING_GITHUB_REPO=""
EXISTING_BUNDLE_RUBYGEMS__PKG__GITHUB__COM=""
EXISTING_NEWRELIC_API_KEY=""
EXISTING_METABASE_URL=""
EXISTING_METABASE_API_KEY=""
EXISTING_CORALOGIX_API_KEY=""
EXISTING_ARB_TOKEN=""

if [ -f "${ENV_FILE}" ]; then
  . "${ENV_FILE}" 2>/dev/null || true
  EXISTING_LITELLM_API_KEY="${LITELLM_API_KEY:-}"
  EXISTING_GITHUB_TOKEN="${GITHUB_TOKEN:-}"
  EXISTING_GIT_USER_NAME="${GIT_USER_NAME:-}"
  EXISTING_GIT_USER_EMAIL="${GIT_USER_EMAIL:-}"
  EXISTING_GITHUB_REPO="${GITHUB_REPO:-}"
  EXISTING_BUNDLE_RUBYGEMS__PKG__GITHUB__COM="${BUNDLE_RUBYGEMS__PKG__GITHUB__COM:-}"
  EXISTING_NEWRELIC_API_KEY="${NEWRELIC_API_KEY:-}"
  EXISTING_METABASE_URL="${METABASE_URL:-}"
  EXISTING_METABASE_API_KEY="${METABASE_API_KEY:-}"
  EXISTING_CORALOGIX_API_KEY="${CORALOGIX_API_KEY:-}"
  EXISTING_ARB_TOKEN="${ARB_TOKEN:-}"
fi

mask() {
  VALUE="$1"
  if [ -z "${VALUE}" ]; then
    echo "(not set)"
  else
    LEN=${#VALUE}
    if [ "${LEN}" -le 8 ]; then
      echo "****"
    else
      echo "$(echo "${VALUE}" | cut -c1-4)...$(echo "${VALUE}" | cut -c$((LEN - 3))-${LEN})"
    fi
  fi
}

echo ""
echo "OpenCode DevEnv Setup"
echo "====================="
echo ""
echo "Credentials are stored on your persistent volume."
echo "Press Enter on any field to keep the existing value."
echo ""

printf "LiteLLM API Key [%s]: " "$(mask "${EXISTING_LITELLM_API_KEY}")"
read INPUT_LITELLM_KEY
LITELLM_KEY="${INPUT_LITELLM_KEY:-${EXISTING_LITELLM_API_KEY}}"

echo ""
echo "--- GitHub ---"
echo ""
echo "Create a classic Personal Access Token at:"
echo "  https://github.com/settings/tokens/new"
echo ""
echo "Scopes needed: repo, read:packages"
echo "After creating, click 'Configure SSO' and authorize g2crowd."
echo ""

printf "GitHub PAT [%s]: " "$(mask "${EXISTING_GITHUB_TOKEN}")"
read INPUT_GH_TOKEN
GH_TOKEN="${INPUT_GH_TOKEN:-${EXISTING_GITHUB_TOKEN}}"

printf "Git Name [%s]: " "${EXISTING_GIT_USER_NAME:-(not set)}"
read INPUT_GIT_NAME
GIT_NAME="${INPUT_GIT_NAME:-${EXISTING_GIT_USER_NAME}}"

printf "Git Email [%s]: " "${EXISTING_GIT_USER_EMAIL:-(not set)}"
read INPUT_GIT_EMAIL
GIT_EMAIL="${INPUT_GIT_EMAIL:-${EXISTING_GIT_USER_EMAIL}}"

printf "GitHub Username (for bundle auth) [%s]: " "${EXISTING_GIT_USER_NAME:-(not set)}"
read INPUT_GH_USERNAME
GH_USERNAME="${INPUT_GH_USERNAME:-${EXISTING_GIT_USER_NAME}}"

echo ""
echo "--- Repo ---"
echo ""

printf "Repo to clone [%s]: " "${EXISTING_GITHUB_REPO:-g2crowd/ue}"
read INPUT_GH_REPO
GH_REPO="${INPUT_GH_REPO:-${EXISTING_GITHUB_REPO:-g2crowd/ue}}"

echo ""
echo "--- MCP Servers ---"
echo ""
echo "API keys for connected services. Press Enter to skip."
echo ""

printf "New Relic API Key [%s]: " "$(mask "${EXISTING_NEWRELIC_API_KEY}")"
read INPUT_NEWRELIC_KEY
NEWRELIC_KEY="${INPUT_NEWRELIC_KEY:-${EXISTING_NEWRELIC_API_KEY}}"

printf "Metabase URL [%s]: " "${EXISTING_METABASE_URL:-https://metrics.g2.com}"
read INPUT_METABASE_URL
METABASE_URL_VAL="${INPUT_METABASE_URL:-${EXISTING_METABASE_URL:-https://metrics.g2.com}}"

printf "Metabase API Key [%s]: " "$(mask "${EXISTING_METABASE_API_KEY}")"
read INPUT_METABASE_KEY
METABASE_KEY="${INPUT_METABASE_KEY:-${EXISTING_METABASE_API_KEY}}"

printf "Coralogix API Key [%s]: " "$(mask "${EXISTING_CORALOGIX_API_KEY}")"
read INPUT_CORALOGIX_KEY
CORALOGIX_KEY="${INPUT_CORALOGIX_KEY:-${EXISTING_CORALOGIX_API_KEY}}"

echo ""
echo "--- arb (GitHub/Jira dispatcher) ---"
echo ""
echo "Watches GitHub PRs/issues and Jira tickets for @ai mentions,"
echo "then dispatches work to OpenCode sessions automatically."
echo ""

printf "arb Token [%s]: " "$(mask "${EXISTING_ARB_TOKEN}")"
read INPUT_ARB_TOKEN
ARB_TOKEN_VAL="${INPUT_ARB_TOKEN:-${EXISTING_ARB_TOKEN}}"

mkdir -p "${WORKSPACES}"

BUNDLE_GH_PACKAGES=""
if [ -n "${GH_USERNAME}" ] && [ -n "${GH_TOKEN}" ]; then
  BUNDLE_GH_PACKAGES="${GH_USERNAME}:${GH_TOKEN}"
fi

cat > "${ENV_FILE}" <<ENVEOF
export LITELLM_API_KEY='${LITELLM_KEY}'
export GITHUB_TOKEN='${GH_TOKEN}'
export GIT_USER_NAME='${GIT_NAME}'
export GIT_USER_EMAIL='${GIT_EMAIL}'
export GITHUB_REPO='${GH_REPO}'
export BUNDLE_RUBYGEMS__PKG__GITHUB__COM='${BUNDLE_GH_PACKAGES}'
export NEWRELIC_API_KEY='${NEWRELIC_KEY}'
export METABASE_URL='${METABASE_URL_VAL}'
export METABASE_API_KEY='${METABASE_KEY}'
export CORALOGIX_API_KEY='${CORALOGIX_KEY}'
export ARB_TOKEN='${ARB_TOKEN_VAL}'
ENVEOF
chmod 600 "${ENV_FILE}"

. "${ENV_FILE}"
export LITELLM_API_KEY GITHUB_TOKEN GIT_USER_NAME GIT_USER_EMAIL GITHUB_REPO
export BUNDLE_RUBYGEMS__PKG__GITHUB__COM

if [ -n "${LITELLM_KEY}" ]; then
  mkdir -p "${AUTH_DIR}"
  printf '{"litellm":{"type":"api","key":"%s"}}' "${LITELLM_KEY}" > "${AUTH_DIR}/auth.json"
  echo "[setup] Generated auth.json for litellm"
fi

if [ -n "${GH_TOKEN}" ]; then
  echo "${GH_TOKEN}" | gh auth login --with-token 2>/dev/null || true
  gh auth setup-git 2>/dev/null || true
  git config --global url."https://github.com/".insteadOf "git@github.com:"
  echo "[setup] Configured GitHub CLI"
fi

if [ -n "${GIT_NAME}" ]; then
  git config --global user.name "${GIT_NAME}"
fi
if [ -n "${GIT_EMAIL}" ]; then
  git config --global user.email "${GIT_EMAIL}"
fi

grep -q 'opencode-env' "${HOME}/.bashrc" 2>/dev/null || echo ". ${ENV_FILE}" >> "${HOME}/.bashrc"
grep -q 'BASH_ENV' "${HOME}/.profile" 2>/dev/null || echo "export BASH_ENV=${ENV_FILE}" >> "${HOME}/.profile"
export BASH_ENV="${ENV_FILE}"

if [ -n "${GH_REPO}" ]; then
  TARGET="${WORKSPACES}/$(echo "${GH_REPO}" | sed 's|.*/||')"
  if [ ! -d "${TARGET}/.git" ]; then
    echo "[setup] Cloning ${GH_REPO}..."
    mkdir -p "${TARGET}"
    git config --global --add safe.directory "${TARGET}"
    git -C "${TARGET}" init
    git -C "${TARGET}" remote add origin "https://github.com/${GH_REPO}.git"
    git -C "${TARGET}" fetch origin
    DEFAULT_BRANCH=$(git -C "${TARGET}" remote show origin 2>/dev/null | grep 'HEAD branch' | awk '{print $NF}') || DEFAULT_BRANCH="main"
    git -C "${TARGET}" checkout -f "${DEFAULT_BRANCH}"
    echo "[setup] Cloned ${GH_REPO}"
  else
    echo "[setup] ${GH_REPO} already cloned at ${TARGET}"
  fi
fi

if [ -n "${ARB_TOKEN_VAL}" ]; then
  ARB_DIR="${HOME}/.local/share/arb"
  ARB_STATE="${HOME}/.local/share/devenv/arb"
  ARB_CONFIG="${ARB_STATE}/arb.json"

  mkdir -p "${ARB_STATE}"

  cat > "${ARB_CONFIG}" <<ARBEOF
{
  "org": "g2crowd",
  "reposDir": "${WORKSPACES}",
  "arbServerUrl": "https://arb.g2.com",
  "arbServerToken": "${ARB_TOKEN_VAL}",
  "intervalMs": 60000,
  "triggerPhrases": ["AI:"],
  "opencodeUrl": "http://localhost:4096",
  "jiraWorkingDir": "${WORKSPACES}"
}
ARBEOF

  ln -sf "${ARB_CONFIG}" "${ARB_DIR}/arb.json"
  for f in sessions.json seen.txt jira_seen.txt last_poll.txt; do
    [ -f "${ARB_STATE}/${f}" ] || touch "${ARB_STATE}/${f}"
    ln -sf "${ARB_STATE}/${f}" "${ARB_DIR}/${f}"
  done

  echo "[setup] Generated arb config and symlinks"
fi

echo ""
echo "Done! Run 'restart' to relaunch OpenCode with your new settings."
