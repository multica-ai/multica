# Optional GitHub / webhook proxy for cron and local scripts (gitignored copy: proxy.env)
# Used by scripts/ai-company/lib/source-local-env.sh when present.

export https_proxy=http://127.0.0.1:7897
export http_proxy=http://127.0.0.1:7897
export all_proxy=socks5://127.0.0.1:7897
export no_proxy=open.feishu.cn,feishu.cn,larksuite.com,127.0.0.1,localhost
