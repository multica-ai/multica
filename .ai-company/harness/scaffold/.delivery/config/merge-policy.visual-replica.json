{
  "$schema": "Visual replica stack auto-merge policy. Deny wins over allow.",
  "autoMergeEnabled": true,
  "requireLabels": ["agent-safe"],
  "branchNamePrefix": "cursor-issue",
  "requiredChecksRegexp": "^(check|frontend|backend|mobile-verify)$",
  "allow": [
    "docs/**",
    "apps/**",
    "e2e/**",
    "playwright.config.ts",
    "package.json",
    "pnpm-lock.yaml",
    "wrangler.toml",
    "Makefile",
    "**/*.md",
    "**/*.mdx",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "public/**",
    "assets/**",
    "locales/**",
    ".delivery/**"
  ],
  "deny": [
    "**/migrations/**",
    "**/auth/**",
    "**/payment/**",
    "**/billing/**",
    "**/.env*",
    "**/secrets/**",
    ".github/workflows/**",
    "docker-compose*.yml",
    "Dockerfile"
  ]
}
