# syntax=docker/dockerfile:1.7
#
# agentfarm-agentrunner — the Multica daemon, running as a single-tenant pod
# that claims tasks for every workspace its PAT has access to.
#
# Reduced to a FROM + entrypoint shim on top of ghcr.io/g2crowd/agent-runtime-base
# (see docker/agent-runtime-base/). The base image bakes in multica + every
# coding-agent CLI the daemon shells out to (claude, codex, opencode, pi,
# hermes), the GitHub CLI for private-repo cloning, plus the substrate (node,
# git, ripgrep, tini, non-root agent user).

ARG BASE_IMAGE=ghcr.io/g2crowd/agent-runtime-base
ARG BASE_TAG=latest

FROM ${BASE_IMAGE}:${BASE_TAG}

USER root

COPY docker/agentrunner/entrypoint.sh /usr/local/bin/entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/entrypoint.sh \
  && chmod +x /usr/local/bin/entrypoint.sh

USER agent

ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/entrypoint.sh"]
