#!/usr/bin/env node
import { spawnSync } from "node:child_process";
import { createHash } from "node:crypto";
import { chmodSync, existsSync, mkdirSync, mkdtempSync, readFileSync, renameSync, rmSync, statSync, writeFileSync } from "node:fs";
import { homedir, tmpdir } from "node:os";
import { basename, dirname, extname, join, resolve } from "node:path";
import { fileURLToPath } from "node:url";

const minimumGh = [2, 103, 2];
// Bump together with the SHA-256 values from the release's gh_<version>_checksums.txt.
export const pinnedGh = {
  version: "2.103.3",
  sha256: {
    "gh_2.103.3_macOS_amd64.zip": "a2f86418f4350ae6e9ec60d5000bdf7665728436946a97fc27fe50e6ae752682",
    "gh_2.103.3_macOS_arm64.zip": "d700207eae9ae98fe2b89535c2c087c07823d4628c56364695a5a07ef311c062",
    "gh_2.103.3_linux_amd64.tar.gz": "4c806978ffce1cec70853302a56d70ac6da4f19bae7adca4e1a8ab00633dd91d",
    "gh_2.103.3_linux_arm64.tar.gz": "ee32df2323c8847f5fac6cb6b4b69ca75828e9329a8f22f677021f7b3306ce63",
    "gh_2.103.3_windows_amd64.zip": "98d0cfa794721665d7973dd728c78aff7bd836d58f10f6d7a03568eccb0a22e0",
    "gh_2.103.3_windows_arm64.zip": "197211c98687d7770ac331fe8a3b6c198c389108c1536cdbedf659fe4703e484",
  },
};

const usage = `Usage: scripts/pr-shots [--repo OWNER/REPO] [--replace OLD_URL] PR FILE...

Upload screenshots or recordings to an existing GitHub PR and print attachment
Markdown to stdout. Diagnostics go to stderr. PR may be a number or GitHub URL.
Requires Node.js 22+ and a gh login with repository write access. If gh is
missing or older than 2.103.2, a checksum-verified gh ${pinnedGh.version} is downloaded
to ~/.cache/multica/gh and used for this script only; the installed gh and its
login are left as they are. PR_SHOTS_GH=/path/to/gh selects a specific binary.

  scripts/pr-shots --repo multica-ai/multica 123 ./before.png ./after.png ./demo.mp4
  scripts/pr-shots --repo multica-ai/multica --replace https://example.com/old.png 123 ./after.png

--replace replaces existing standalone inline image references, keeping their
alt text and surrounding prose; it accepts exactly one file. Without it, new
attachments are appended. Identical content already marked in this PR is reused.
Run only one uploader per PR at a time; avoid editing its body during upload.
`;

function parseArgs(args) {
  const options = { files: [], repo: "", replace: "", pr: "" };
  let positional = false;
  for (let i = 0; i < args.length; i++) {
    const arg = args[i];
    if (!positional && (arg === "--help" || arg === "-h")) return { help: true };
    if (!positional && arg === "--") { positional = true; continue; }
    if (!positional && (arg === "--repo" || arg === "-R" || arg === "--replace")) {
      const value = args[++i];
      if (!value || value.startsWith("-")) throw new Error(`Missing value for ${arg}`);
      options[arg === "--replace" ? "replace" : "repo"] = value;
    } else if (!positional && arg.startsWith("-")) {
      throw new Error(`Unknown option: ${arg}`);
    } else if (!options.pr) options.pr = arg;
    else options.files.push(arg);
  }
  if (!options.pr || !options.files.length) throw new Error(usage);
  if (!/^[1-9]\d*$/.test(options.pr) && !/^https:\/\/github\.com\/[^/]+\/[^/]+\/pull\/[1-9]\d*$/.test(options.pr)) {
    throw new Error("PR must be a positive number or a github.com pull request URL");
  }
  if (options.repo && !/^[\w.-]+\/[\w.-]+$/.test(options.repo)) throw new Error("--repo must be OWNER/REPO");
  if (options.replace && (options.files.length !== 1 || !/^https:\/\/[^\s<>]+$/.test(options.replace))) {
    throw new Error("--replace requires an HTTPS URL and exactly one file");
  }
  return options;
}

function run(command, args, timeout = 120_000) {
  const result = spawnSync(command, args, { encoding: "utf8", timeout, maxBuffer: 4 * 1024 * 1024, stdio: ["ignore", "pipe", "pipe"] });
  return { status: result.status ?? 1, stdout: result.stdout ?? "", stderr: result.error?.message ?? result.stderr ?? "" };
}

export function ghRunner(binary) { return (args) => run(binary, args); }

function checkedGh(gh, args) {
  const result = gh(args);
  if (result.status !== 0) throw new Error(result.stderr.trim() || `gh ${args.slice(0, 2).join(" ")} failed`);
  return result.stdout;
}

function ghVersion(gh) {
  const result = gh(["--version"]);
  const match = result.status === 0 && result.stdout.match(/^gh version (\d+)\.(\d+)\.(\d+)/);
  return match ? match.slice(1).map(Number) : null;
}

function supportedGh(version) {
  const index = version ? version.findIndex((part, i) => part !== minimumGh[i]) : 0;
  return !!version && (index === -1 || version[index] > minimumGh[index]);
}

function ghAsset(release, platform, arch) {
  const os = { darwin: "macOS", linux: "linux", win32: "windows" }[platform];
  const cpu = { x64: "amd64", arm64: "arm64" }[arch];
  const name = `gh_${release.version}_${os}_${cpu}${os === "linux" ? ".tar.gz" : ".zip"}`;
  if (!os || !cpu || !release.sha256[name]) return null;
  return { name, sha256: release.sha256[name], url: `https://github.com/cli/cli/releases/download/v${release.version}/${name}` };
}

function cachedGh(directory, asset) {
  const stem = asset.name.replace(/\.(zip|tar\.gz)$/, "");
  return [join(directory, stem, "bin", "gh"), join(directory, "bin", "gh.exe")].find((path) => existsSync(path)) ?? "";
}

function manualSteps(asset, directory, platform) {
  if (!asset || platform === "win32") {
    return `Install any gh ${minimumGh.join(".")}+ binary from https://github.com/cli/cli/releases (no global install needed)${asset ? `, for example ${asset.url} (SHA-256 ${asset.sha256})` : ""}, then re-run with PR_SHOTS_GH=<path to gh>.`;
  }
  const archive = join(directory, asset.name);
  const verify = platform === "darwin" ? "shasum -a 256 -c" : "sha256sum -c";
  return [
    "Set it up by hand with the same verified file, then re-run the same command:",
    `  mkdir -p '${directory}'`,
    `  curl -fL -o '${archive}' ${asset.url}`,
    `  echo '${asset.sha256}  ${archive}' | ${verify}`,
    `  tar -xf '${archive}' -C '${directory}'`,
    `Or point PR_SHOTS_GH at any gh ${minimumGh.join(".")}+ binary.`,
  ].join("\n");
}

function download(url, destination) {
  const result = run("curl", ["-fsSL", "--retry", "2", "--connect-timeout", "20", "-o", destination, url], 300_000);
  if (result.status !== 0) throw new Error(`download failed: ${result.stderr.trim() || `curl exited ${result.status}`}`);
}

function extract(archive, directory) {
  const result = run("tar", ["-xf", archive, "-C", directory], 300_000);
  if (result.status !== 0) throw new Error(`extract failed: ${result.stderr.trim() || `tar exited ${result.status}`}`);
}

export function installPinnedGh({
  release = pinnedGh,
  cacheRoot = join(process.env.XDG_CACHE_HOME || join(homedir(), ".cache"), "multica", "gh"),
  platform = process.platform,
  arch = process.arch,
  fetch = download,
  unpack = extract,
  log = () => {},
} = {}) {
  const asset = ghAsset(release, platform, arch);
  const directory = join(cacheRoot, release.version, `${platform}-${arch}`);
  const fail = (reason) => new Error(`Could not set up gh ${release.version}: ${reason}\n${manualSteps(asset, directory, platform)}`);
  if (!asset) throw fail(`no pinned build for ${platform}/${arch}`);
  const cached = cachedGh(directory, asset);
  if (cached) return cached;
  log(`Downloading gh ${release.version} to ${directory}`);
  let staging;
  try {
    mkdirSync(join(cacheRoot, release.version), { recursive: true });
    staging = mkdtempSync(join(cacheRoot, release.version, ".download-"));
    const archive = join(staging, asset.name);
    fetch(asset.url, archive);
    const actual = createHash("sha256").update(readFileSync(archive)).digest("hex");
    if (actual !== asset.sha256) throw new Error(`${asset.name} has SHA-256 ${actual}, expected ${asset.sha256}`);
    const unpacked = join(staging, "unpacked");
    mkdirSync(unpacked);
    unpack(archive, unpacked);
    const binary = cachedGh(unpacked, asset);
    if (!binary) throw new Error(`${asset.name} does not contain bin/gh`);
    if (platform !== "win32") chmodSync(binary, 0o755);
    if (!cachedGh(directory, asset)) rmSync(directory, { recursive: true, force: true });
    try { renameSync(unpacked, directory); } catch (error) {
      if (!cachedGh(directory, asset)) throw error; // A concurrent run installed it first.
    }
    return cachedGh(directory, asset);
  } catch (error) {
    throw fail(error.message);
  } finally {
    if (staging) rmSync(staging, { recursive: true, force: true });
  }
}

function resolveGh(gh, { override, installGh, runner, log }) {
  const version = ghVersion(gh);
  if (supportedGh(version)) return gh;
  const found = version ? `gh ${version.join(".")} is older than ${minimumGh.join(".")}` : "gh was not found or did not report a version";
  if (override) throw new Error(`PR_SHOTS_GH=${override}: ${found}`);
  log(`${found}; using a cached gh ${pinnedGh.version} for this run (the installed gh is unchanged)`);
  const binary = installGh({ log });
  const pinned = runner(binary);
  if (!supportedGh(ghVersion(pinned))) {
    throw new Error(`${binary} did not run as gh ${minimumGh.join(".")}+; delete ${dirname(dirname(binary))} and retry`);
  }
  log(`Using ${binary}`);
  return pinned;
}

function snapshot(file) {
  const path = resolve(file);
  const extension = extname(path).slice(1).toLowerCase();
  const video = ["mp4", "mov", "webm"].includes(extension);
  if (!video && !["png", "jpg", "jpeg", "gif", "webp", "svg"].includes(extension)) {
    throw new Error(`${file}: unsupported image/video extension`);
  }
  const info = statSync(path);
  const limit = (video ? 100 : 10) * 1024 * 1024;
  if (!info.isFile() || info.size === 0 || info.size > limit) throw new Error(`${file}: expected a nonempty file up to ${video ? 100 : 10} MB`);
  const bytes = readFileSync(path);
  return { path, extension, video, bytes, hash: createHash("sha256").update(bytes).digest("hex") };
}

function marker(hash) { return `<!-- pr-shots:sha256=${hash} -->`; }
function escapeRegex(value) { return value.replace(/[.*+?^${}()|[\]\\]/g, "\\$&"); }
function escapeAlt(value) { return value.replace(/\\/g, "\\\\").replace(/\[/g, "\\[").replace(/\]/g, "\\]").replace(/[\r\n]/g, " "); }

function nativeUrl(value) {
  try {
    const url = new URL(value);
    return url.protocol === "https:" && url.hostname === "github.com" && /^\/user-attachments\/assets\/[\w-]+$/.test(url.pathname);
  } catch { return false; }
}

function savedAttachment(body, hash) {
  const pattern = new RegExp(`${escapeRegex(marker(hash))}[ \\t]*\\r?\\n(?:[ \\t]*\\r?\\n)*([^\\r\\n]+)`, "g");
  for (const match of body.matchAll(pattern)) {
    const markdown = match[1].trim();
    const image = markdown.match(/^!\[(?:\\.|[^\]\\])*\]\((https:\/\/[^\s)]+)\)$/);
    const url = image ? image[1] : markdown;
    if (nativeUrl(url)) return { markdown, url };
  }
  return null;
}

function replaceImage(body, oldUrl, newUrl, hash) {
  const pattern = new RegExp(`^(!\\[(?:\\\\.|[^\\]\\\\])*\\]\\()${escapeRegex(oldUrl)}(\\))[ \\t]*$`, "gm");
  let count = 0;
  const next = body.replace(pattern, (_match, before, after) => {
    count++;
    return `${marker(hash)}\n\n${before}${newUrl}${after}`;
  });
  if (!count) throw new Error("--replace URL must match an existing image on its own line; the PR was not changed");
  return next;
}

export function runPrShots(args, {
  env = process.env,
  gh = ghRunner(env.PR_SHOTS_GH || "gh"),
  installGh = installPinnedGh,
  runner = ghRunner,
  out = (text) => process.stdout.write(text),
  log = (text) => process.stderr.write(`${text}\n`),
} = {}) {
  let directory;
  try {
    const options = parseArgs(args);
    if (options.help) { out(usage); return 0; }
    // Snapshot every input before the first remote mutation, including paths with #.
    const files = [...new Map(options.files.map((file) => {
      const asset = snapshot(file);
      return [asset.hash, asset];
    })).values()];
    if (options.replace && files[0].video) throw new Error("--replace supports images; append recordings instead");
    gh = resolveGh(gh, { override: env.PR_SHOTS_GH, installGh, runner, log });
    const readPr = (target, repo = "") => {
      const flags = repo ? ["--repo", repo] : [];
      const pr = JSON.parse(checkedGh(gh, ["pr", "view", target, ...flags, "--json", "body,url"]));
      if (typeof pr.body !== "string" || !/^https:\/\/github\.com\/[^/]+\/[^/]+\/pull\/[1-9]\d*$/.test(pr.url)) {
        throw new Error("Expected a GitHub.com PR body and canonical URL");
      }
      return pr;
    };
    const target = readPr(options.pr, options.repo).url;
    directory = mkdtempSync(join(tmpdir(), "pr-shots-"));
    for (let i = 0; i < files.length; i++) {
      const file = files[i];
      try {
        const pr = readPr(target);
        const existing = savedAttachment(pr.body, file.hash);
        if (existing && (!options.replace || !pr.body.includes(options.replace))) {
          log(`Reused ${basename(file.path)}`);
          out(`${existing.markdown}\n\n`);
          continue;
        }
        const staged = join(directory, `${file.hash}.${file.extension}`);
        writeFileSync(staged, file.bytes, { mode: 0o600 });
        const destination = existing?.url ?? staged;
        const markdown = file.video ? `![](${destination})` : `![${escapeAlt(basename(file.path))}](${destination})`;
        const body = options.replace
          ? replaceImage(pr.body, options.replace, destination, file.hash)
          : `${pr.body}${pr.body ? "\n\n" : ""}${marker(file.hash)}\n\n${markdown}\n`;
        const bodyFile = join(directory, "body.md");
        writeFileSync(bodyFile, body, { mode: 0o600 });
        const attach = existing ? [] : ["--attach", staged];
        const result = gh(["pr", "edit", target, "--body-file", bodyFile, ...attach]);
        // A nonzero exit can follow a successful write: read back before retrying.
        const saved = savedAttachment(readPr(target).body, file.hash);
        if (!saved) throw new Error(result.stderr.trim() || "Upload was not confirmed in the PR body; inspect the PR before retrying");
        out(`${saved.markdown}\n\n`);
        log(`Saved ${basename(file.path)}`);
        if (result.status !== 0) throw new Error(`Attachment saved, but gh exited ${result.status}: ${result.stderr.trim()}`);
      } catch (error) {
        log(`Failed ${basename(file.path)}: ${error.message}`);
        if (i + 1 < files.length) log(`Not attempted: ${files.slice(i + 1).map((file) => basename(file.path)).join(", ")}`);
        log("Earlier confirmed attachments remain saved. Re-run the same command to reuse them.");
        return 1;
      }
    }
    return 0;
  } catch (error) {
    log(error.message);
    return 1;
  } finally {
    if (directory) rmSync(directory, { recursive: true, force: true });
  }
}

if (process.argv[1] && resolve(process.argv[1]) === fileURLToPath(import.meta.url)) {
  process.exitCode = runPrShots(process.argv.slice(2));
}
