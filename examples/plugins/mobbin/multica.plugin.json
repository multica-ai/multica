{
  "api_version": "multica.plugin/v1",
  "kind": "Plugin",
  "metadata": {
    "key": "dev.multica.mobbin-design-reference",
    "name": "Mobbin Design Reference",
    "description": "Example Plugin combining Mobbin design-research guidance with Mobbin's OAuth-protected hosted MCP server",
    "version": "0.2.0",
    "publisher": "multica.examples"
  },
  "compatibility": {
    "host_api": ">=1.0.0 <2.0.0",
    "required_daemon_features": [
      "execution-manifest-v1",
      "agent-skill-v1",
      "remote-mcp-v1"
    ]
  },
  "requested_capabilities": [
    "agent.skill.contribute",
    "tool.remote-mcp.connect"
  ],
  "contributes": {
    "agent_skills": [
      {
        "key": "mobbin-design-research",
        "name": "Mobbin Design Research",
        "description": "Research real shipped screens and flows before designing or reviewing product interfaces.",
        "entry": "skills/mobbin-design-research/SKILL.md"
      }
    ],
    "remote_mcp": [
      {
        "key": "mobbin",
        "name": "Mobbin",
        "description": "Search Mobbin's hosted library of real product screens and flows",
        "transport": "streamable-http",
        "protocol_versions": ["2025-03-26", "2024-11-05"],
        "endpoint_policy": {
          "default_endpoint": "https://api.mobbin.com/mcp",
          "allowed_hosts": ["api.mobbin.com"]
        },
        "authentication": {
          "preferred": "oauth",
          "supported": ["oauth"]
        },
        "tool_intent": [
          {
            "name": "*",
            "description": "Discover Mobbin's authenticated research tools for explicit administrator review.",
            "risk": "write"
          }
        ],
        "configuration_schema": {
          "type": "object",
          "additionalProperties": false
        }
      }
    ]
  }
}
