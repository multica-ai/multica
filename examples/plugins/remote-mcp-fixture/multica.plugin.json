{
  "api_version": "multica.plugin/v1",
  "kind": "Plugin",
  "metadata": {
    "key": "dev.multica.remote-mcp-fixture",
    "name": "Remote MCP Fixture",
    "description": "Reference Remote MCP Plugin with deterministic read and write tools",
    "version": "1.0.0",
    "publisher": "multica.dev"
  },
  "compatibility": {
    "host_api": ">=1.0.0 <2.0.0",
    "required_daemon_features": [
      "execution-manifest-v1",
      "remote-mcp-v1"
    ]
  },
  "requested_capabilities": [
    "tool.remote-mcp.connect"
  ],
  "contributes": {
    "remote_mcp": [
      {
        "key": "fixture-tools",
        "name": "Fixture Tools",
        "description": "Exercises Remote MCP discovery, approval, read, and write paths",
        "transport": "streamable-http",
        "protocol_versions": ["2025-03-26"],
        "endpoint_policy": {
          "allowed_hosts": ["mcp-fixture.example.com"]
        },
        "tool_intent": [
          {
            "name": "fixture.read",
            "description": "Read a deterministic fixture value",
            "risk": "read"
          },
          {
            "name": "fixture.write",
            "description": "Append a value to the fixture log",
            "risk": "write"
          }
        ],
        "configuration_schema": {
          "type": "object",
          "additionalProperties": false
        }
      }
    ]
  }
}
