# Review ingest — production shape. Secret values live in the server's .env,
# never in git. Copy to .env on the host and fill in from Infisical.
PORT=8095
MULTICA_API=http://localhost:8090

# SECRET — a mul_ personal access token. Never commit a real value.
MULTICA_TOKEN=

# SECRET — HMAC signing key for review links. Generate: openssl rand -hex 32
REVIEW_SECRET=

# Lock this down in production — only the dev sites carrying the widget.
ALLOWED_ORIGINS=https://dart.flexmedia.is

REVIEW_BASE_IPS=https://dart.flexmedia.is
