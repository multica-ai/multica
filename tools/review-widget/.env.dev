# Review ingest — local dev defaults. Copy to .env and fill in the secrets.
PORT=8095
MULTICA_API=http://localhost:8090

# SECRET — a mul_ personal access token. Never commit a real value.
MULTICA_TOKEN=

# SECRET — HMAC signing key for review links. Generate: openssl rand -hex 32
REVIEW_SECRET=

# Comma-separated origins allowed to POST. Empty = reflect caller (dev only).
ALLOWED_ORIGINS=

# Base URLs used by mint-review-link, per project slug.
REVIEW_BASE_IPS=http://localhost:5174
