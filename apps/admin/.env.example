# Postgres connection is inherited from the repo-root DATABASE_URL
# (see ../../.env.example) — this app only reads from it, never writes.

# LiteLLM proxy admin API (e.g. https://llmproxy.g2.com/v1). Leave unset to
# run with the LiteLLM sections showing a "not linked"/empty state instead
# of cost data — see lib/litellm.ts's litellmConfigured() guard.
LLMPROXY_BASE_URL=
# Master key or a key scoped to /key/list, /team/daily/activity, and spend routes.
LLMPROXY_MASTER_KEY=

ADMIN_PORT=3002

# Workspace-invite writes (POST /api/workspaces/[id]/invitations) go to the
# Go backend as the bot PAT — same pattern as gandalf's workspace-create
# flow (~/WORK/gandalf/src/services/workspace-create.service.ts). BOT_PAT
# itself comes from the repo-root env / SSM glob, not this file.
AGENTFARM_API_BASE_URL=http://localhost:8080
BOT_PAT=
# Must already be an owner/admin member of a workspace for invites into it
# to succeed — see lib/invite-eligibility.ts. Defaults to the same account
# gandalf hardcodes; only set this if your local bot account differs.
AGENTFARM_BOT_EMAIL=

# This app has no authentication and reads Postgres + LiteLLM directly, so
# middleware.ts refuses every request when NODE_ENV=production unless this
# is explicitly set to "true" — see lib/access-guard.ts. Do not set this
# until the deployment is otherwise access-controlled (VPN/IAP) or real
# auth has been added.
ADMIN_ALLOW_UNSAFE_NO_AUTH=
