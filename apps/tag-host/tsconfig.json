{
  "extends": "@multica/tsconfig/react-library.json",
  "compilerOptions": {
    "baseUrl": ".",
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "noEmit": true,
    "paths": {
      "@/*": ["./src/*"]
    },
    "types": ["vite/client", "node"]
  },
  "include": ["src/**/*.ts", "src/**/*.tsx", "vite.config.ts"]
}
