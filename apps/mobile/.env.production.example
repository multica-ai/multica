# Copy this file to .env.production.local and edit it before running a
# production-variant build. The .local file is gitignored.
#
# These are the public Multica defaults. Replace them if you run a private
# backend.
EXPO_PUBLIC_API_URL=https://api.multica.ai
EXPO_PUBLIC_WEB_URL=https://multica.ai

# Optional: use your own reverse-domain if your Apple ID cannot sign the
# default production bundle ID.
# EXPO_BUNDLE_IDENTIFIER_PROD=com.yourname.multica
