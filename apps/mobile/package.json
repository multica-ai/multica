{
  "name": "@multica/mobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "dev:staging": "dotenv -e .env.staging -- cross-env APP_ENV=staging expo start",
    "dev:prod": "dotenv -e .env.production.local -e .env.production -- cross-env APP_ENV=production expo start",
    "ios": "./scripts/ios-run.sh",
    "ios:staging": "dotenv -e .env.staging -- cross-env APP_ENV=staging ./scripts/ios-run.sh",
    "ios:prod": "dotenv -e .env.production.local -e .env.production -- cross-env APP_ENV=production ./scripts/ios-run.sh",
    "ios:device": "./scripts/ios-run.sh --device",
    "ios:device:staging": "dotenv -e .env.staging -- cross-env APP_ENV=staging ./scripts/ios-run.sh --device",
    "ios:device:staging:release": "dotenv -e .env.staging -- cross-env APP_ENV=staging ./scripts/ios-run.sh --device --configuration Release",
    "ios:device:prod": "dotenv -e .env.production.local -e .env.production -- cross-env APP_ENV=production ./scripts/ios-run.sh --device",
    "ios:device:prod:release": "dotenv -e .env.production.local -e .env.production -- cross-env APP_ENV=production ./scripts/ios-run.sh --device --configuration Release",
    "lint": "expo lint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run && bash scripts/ios-run.test.sh"
  },
  "dependencies": {
    "@expo/dom-webview": "~57.0.1",
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.1.1",
    "@multica/core": "workspace:*",
    "@react-native-community/datetimepicker": "9.1.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-native-segmented-control/segmented-control": "2.5.7",
    "@rn-primitives/avatar": "^1.4.0",
    "@rn-primitives/collapsible": "^1.4.0",
    "@rn-primitives/dropdown-menu": "^1.4.0",
    "@rn-primitives/portal": "^1.4.0",
    "@rn-primitives/radio-group": "^1.4.0",
    "@rn-primitives/separator": "^1.4.0",
    "@rn-primitives/slot": "^1.4.0",
    "@rn-primitives/switch": "^1.4.0",
    "@rn-primitives/tabs": "^1.4.0",
    "@shikijs/core": "^4.0.2",
    "@shikijs/langs": "^4.0.2",
    "@shikijs/themes": "^4.0.2",
    "@shopify/flash-list": "2.0.2",
    "@tanstack/react-query": "^5.96.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.26",
    "expo-build-properties": "~57.0.22",
    "expo-clipboard": "~57.0.2",
    "expo-constants": "~57.0.20",
    "expo-dev-client": "^57.0.19",
    "expo-document-picker": "~57.0.3",
    "expo-haptics": "~57.0.3",
    "expo-image": "^57.0.5",
    "expo-image-picker": "~57.0.20",
    "expo-linking": "~57.0.11",
    "expo-localization": "~57.0.2",
    "expo-router": "~57.0.24",
    "expo-secure-store": "~57.0.4",
    "expo-status-bar": "~57.0.1",
    "expo-system-ui": "~57.0.4",
    "i18next": "catalog:",
    "input-otp-native": "^0.5.0",
    "marked": "^18.0.3",
    "nativewind": "^4.1.23",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-i18next": "catalog:",
    "react-native": "0.86.3",
    "react-native-enriched-markdown": "^0.6.0",
    "react-native-gesture-handler": "~2.32.0",
    "react-native-image-viewing": "^0.2.2",
    "react-native-keyboard-controller": "1.21.9",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.2",
    "react-native-shiki-engine": "^0.3.10",
    "react-native-svg": "15.15.4",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1",
    "rn-emoji-keyboard": "^1.7.0",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.17",
    "tailwindcss-animate": "^1.0.7",
    "zod": "^4.1.5",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@babel/core": "^7.25.0",
    "@types/react": "~19.0.0",
    "cross-env": "^7.0.3",
    "dotenv-cli": "^7.4.4",
    "eslint-config-expo": "~57.0.2",
    "typescript": "~6.0.3",
    "vitest": "catalog:"
  }
}
