# Copy this file to .env.staging and point it at the internal staging
# environment before running `pnpm dev:mobile:staging` or the
# `ios:*:staging` scripts. The copy is gitignored; get the current staging
# URLs from the team instead of committing them. Loaded via `dotenv-cli`
# (see package.json), NOT by Expo's auto-loader.
EXPO_PUBLIC_API_URL=https://api.staging.example.com

# Optional. Enables "Copy link" / "Open on web" actions in issue / project /
# comment menus. Without it those menu items just don't appear.
EXPO_PUBLIC_WEB_URL=https://app.staging.example.com
