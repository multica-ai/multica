# Copy this file to .env.staging and point it at the internal staging
# environment before running `pnpm dev:desktop:staging`
# (`electron-vite dev --mode staging`). The copy is gitignored; get the
# current staging URLs from the team instead of committing them.
VITE_API_URL=https://api.staging.example.com

# VITE_APP_URL is the web app origin used for copy-link/open-in-browser URLs.
# Do not point it at the API host. Set it explicitly: the `api.<host>`
# derivation in shared/runtime-config.ts falls back to the API origin when the
# deployment does not follow that naming (MUL-5025).
VITE_APP_URL=https://app.staging.example.com
