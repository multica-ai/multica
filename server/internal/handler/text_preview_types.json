{
  "$comment": "Source of truth for text attachment preview types. Edit this file only, then run `pnpm generate:text-preview-types`. The generator validates the data and updates the Go and TypeScript lookup tables consumed by the preview proxy and client dispatcher.",
  "contentTypes": [
    "application/json",
    "application/javascript",
    "application/xml",
    "application/x-yaml",
    "application/yaml",
    "application/toml",
    "application/x-sh",
    "application/x-httpd-php"
  ],
  "extensionGroups": [
    {
      "label": "Markdown",
      "language": "markdown",
      "extensions": ["md", "markdown"]
    },
    {
      "label": "Plain text",
      "language": "plaintext",
      "extensions": ["txt", "log", "csv", "tsv", "gitignore"]
    },
    {
      "label": "Web",
      "language": "xml",
      "extensions": ["html", "htm", "xml"]
    },
    {
      "label": "Stylesheets",
      "language": "css",
      "extensions": ["css"]
    },
    {
      "label": "Sass",
      "language": "scss",
      "extensions": ["scss", "sass"]
    },
    {
      "label": "Less",
      "language": "less",
      "extensions": ["less"]
    },
    {
      "label": "JSON",
      "language": "json",
      "extensions": ["json"]
    },
    {
      "label": "YAML",
      "language": "yaml",
      "extensions": ["yml", "yaml"]
    },
    {
      "label": "INI-style config",
      "language": "ini",
      "extensions": ["toml", "ini", "conf"]
    },
    {
      "label": "Build files",
      "language": "dockerfile",
      "extensions": ["dockerfile"]
    },
    {
      "label": "Makefiles",
      "language": "makefile",
