;; Multica agent sandbox — generated, do not edit manually.
(version 1)
(deny default)
(debug deny)

;; Process & signal
(allow process-fork)
(allow process-exec)
(allow signal (target self))

;; System lookups & IPC
(allow mach-lookup)
(allow ipc-posix-shm)
(allow sysctl-read)
(allow iokit-open)
(allow file-ioctl)

;; Filesystem reads (system)
(allow file-read-metadata)
(allow file-read* (literal "/"))
(allow file-read* (subpath "/usr"))
(allow file-read* (subpath "/bin"))
(allow file-read* (subpath "/sbin"))
(allow file-read* (subpath "/System"))
(allow file-read* (subpath "/Library"))
(allow file-read* (subpath "/opt/homebrew"))
(allow file-read* (subpath "/opt/local"))
(allow file-read* (subpath "/private/etc"))
(allow file-read* (subpath "/private/var/db"))
(allow file-read* (subpath "/private/var/select"))
(allow file-read* (subpath "/Applications"))

;; Workdir & temp (read+write)
(allow file-read* file-write* (subpath "/Users/sandbox/work"))
(allow file-read* file-write* (subpath "/Users/sandbox/work/.tmp"))
(allow file-read* file-write* (subpath "/private/var/folders"))
(allow file-read* file-write* (subpath "/private/tmp"))
(allow file-read* file-write* (subpath "/tmp"))

;; Standard devices
(allow file-read* file-write* (literal "/dev/null") (literal "/dev/zero")
    (literal "/dev/random") (literal "/dev/urandom")
    (literal "/dev/dtracehelper") (literal "/dev/tty"))
(allow file-read* (subpath "/dev/fd"))
(allow file-read* (subpath "/dev/null"))

;; Home (selective read)
(allow file-read* (subpath "/Users/sandbox/.cache"))
(allow file-read* (subpath "/Users/sandbox/.config"))
(allow file-read* (subpath "/Users/sandbox/.npm"))
(allow file-read* (subpath "/Users/sandbox/.pnpm-store"))
(allow file-read* (subpath "/Users/sandbox/.yarn"))
(allow file-read* (subpath "/Users/sandbox/.cargo"))
(allow file-read* (subpath "/Users/sandbox/.rustup"))
(allow file-read* (subpath "/Users/sandbox/.rbenv"))
(allow file-read* (subpath "/Users/sandbox/.pyenv"))
(allow file-read* (subpath "/Users/sandbox/.nvm"))
(allow file-read* (subpath "/Users/sandbox/.asdf"))
(allow file-read* (subpath "/Users/sandbox/.local/bin"))
(allow file-read* (subpath "/Users/sandbox/.local/share"))
(allow file-read* (subpath "/Users/sandbox/Library/Caches"))
(allow file-read* (subpath "/Users/sandbox/Library/Preferences"))
(allow file-read* (subpath "/Users/sandbox/Library/Logs"))

;; Sensitive home subpaths — DENY (defense in depth)
(deny file-read* file-write* (subpath "/Users/sandbox/.ssh"))
(deny file-read* file-write* (subpath "/Users/sandbox/.aws"))
(deny file-read* file-write* (subpath "/Users/sandbox/.gcloud"))
(deny file-read* file-write* (subpath "/Users/sandbox/.config/gcloud"))
(deny file-read* file-write* (subpath "/Users/sandbox/.azure"))
(deny file-read* file-write* (subpath "/Users/sandbox/.kube"))
(deny file-read* file-write* (subpath "/Users/sandbox/.docker"))
(deny file-read* file-write* (subpath "/Users/sandbox/.gnupg"))
(deny file-read* file-write* (subpath "/Users/sandbox/.password-store"))
(deny file-read* file-write* (subpath "/Users/sandbox/.netrc"))
(deny file-read* file-write* (subpath "/Users/sandbox/Library/Application Support"))
(deny file-read* file-write* (subpath "/Users/sandbox/Library/Cookies"))
(deny file-read* file-write* (subpath "/Users/sandbox/Library/Keychains"))
(deny file-read* file-write* (subpath "/Users/sandbox/Library/Mail"))
(deny file-read* file-write* (subpath "/Users/sandbox/Library/Messages"))

;; Network (deny by default; allow specific hosts)
(allow network-outbound (remote tcp "127.0.0.1:19514"))
(allow network-outbound (remote tcp "api.anthropic.com:443"))
(allow network-outbound (remote tcp "multica.example.com:443"))
(allow network-outbound (remote udp "*:53"))
(allow network-bind (local ip "localhost:*"))

