# --- Cloud runtime image ---
# A headless Multica daemon ("runtime") that runs in a container instead of on a
# developer Mac. It connects OUTBOUND to a Multica backend, polls for tasks, and
# executes them with the Claude Code CLI. No inbound ports — the worker is
# private with only outgoing traffic, so it needs no DNS, domain, or tunnel.
#
# See CLOUD_RUNTIME.md for the env vars, volumes, and deploy steps (Sliplane).

# --- Build stage: compile the cerebro multica binary from source ---
# We build from our fork (not the upstream GitHub release) so the daemon ships
# with the cerebro patches.
FROM golang:1.26-alpine AS builder

RUN apk add --no-cache git

WORKDIR /src
# server/go.mod has local `replace` directives, so every referenced module tree
# must be present before `go mod download` runs.
COPY server/go.mod server/go.sum ./server/
COPY packages/cerebro-pdf-text/ ./packages/cerebro-pdf-text/
COPY packages/cerebro-attachment-text/ ./packages/cerebro-attachment-text/
COPY packages/cerebro-pi-harness/ ./packages/cerebro-pi-harness/
RUN cd server && go mod download
COPY server/ ./server/

# The "Create with agent" flow gates on the CLI version the daemon reports at
# registration (server/pkg/agent/version.go): it must parse as semver >= 0.2.20,
# or match the git-describe dev shape (vX.Y.Z-N-gSHA). A binary built with
# VERSION=dev reports "dev", which reads as "no version reported" and disables
# Create with agent. So the default below is a real release baseline, never
# "dev". CI / the runtime-deploy skill SHOULD override it with the exact source
# version: --build-arg VERSION=$(git describe --tags --match 'v[0-9].[0-9]*' --always).
# When no build-arg is passed (e.g. Sliplane auto-deploy, which does not pass one),
# this default is what the runtime reports in `multica runtime list`, so keep it
# bumped to the current release line (homebrew-tap latest) instead of letting it
# drift back to a stale baseline.
ARG VERSION=v1.11.2
ARG COMMIT=unknown
RUN cd server && CGO_ENABLED=0 go build -ldflags "-s -w -X main.version=${VERSION} -X main.commit=${COMMIT}" -o bin/multica ./cmd/multica

# --- Runtime stage: Node base for the Claude Code CLI + git for repo checkouts ---
FROM node:22-bookworm-slim

# git: the daemon checks out repos into per-task worktrees.
# ripgrep: Claude Code's search backend. curl/jq/ca-certificates: setup-token
# exchange + TLS. tini: clean PID 1 signal handling for the long-running daemon.
RUN apt-get update && apt-get install -y --no-install-recommends \
      git ripgrep curl jq ca-certificates tini \
    && rm -rf /var/lib/apt/lists/*

# Agent CLIs that the daemon shells out to. Pi is pinned so an upstream CLI
# release cannot change the runtime protocol without a reviewed image update.
RUN npm install -g @anthropic-ai/claude-code && claude --version
RUN npm install -g --ignore-scripts @earendil-works/pi-coding-agent@0.80.7 \
    && pi --version

COPY --from=builder /src/server/bin/multica /usr/local/bin/multica
COPY docker/runtime-entrypoint.sh /usr/local/bin/runtime-entrypoint.sh
RUN sed -i 's/\r$//' /usr/local/bin/runtime-entrypoint.sh \
    && chmod +x /usr/local/bin/runtime-entrypoint.sh

# Run as a non-root user (container-hardening baseline, FIR-2105).
RUN useradd --create-home --shell /bin/bash multica
USER multica
WORKDIR /home/multica

ENV HOME=/home/multica \
    MULTICA_WORKSPACES_ROOT=/home/multica/workspaces \
    MULTICA_CLAUDE_PATH=/usr/local/bin/claude \
    MULTICA_PI_PATH=/usr/local/bin/pi \
    PI_CODING_AGENT_DIR=/home/multica/.multica/pi

# No EXPOSE — the runtime makes only outbound connections.
ENTRYPOINT ["/usr/bin/tini", "--", "/usr/local/bin/runtime-entrypoint.sh"]
