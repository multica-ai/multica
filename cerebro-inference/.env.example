# Multica inference container — env vars

# Shared secret. The multica backend sends this as `Authorization: Bearer ...`.
# Generate with: openssl rand -hex 32
INFERENCE_API_KEY=

# HF token — required to pull syvai/plapre-nano (gated, CC-BY-4.0).
# Once a token with access to plapre-nano + hviske-v3 is configured here,
# scripts/entrypoint.sh prefetches both at container start.
HF_TOKEN=

# Optional: skip the prefetch (already-warmed volume mount, or testing).
# 0 = prefetch on start (default), 1 = skip.
INFERENCE_SKIP_PREFETCH=0

# Mock mode: serve a synthetic sine-wave for /synthesize and a fixed transcript
# for /transcribe instead of running the real models. Useful for CI, frontend
# integration without a GPU, and end-to-end protocol tests.
INFERENCE_MOCK_MODE=0

# Model overrides (defaults match the issue's chosen models).
PLAPRE_MODEL_ID=syvai/plapre-nano
# Voice IDs: ida, liv, tor, ask, kaj (see GET /plapre/voices).
PLAPRE_DEFAULT_VOICE=ida
# Fraction of GPU VRAM reserved for plapre's vLLM. 0.30 = ~6 GB on a 20 GB
# card; lower if hviske + activations need more headroom.
PLAPRE_GPU_MEMORY_UTILIZATION=0.30

# Hviske is filled in by JEH-729 slice 4 — these are placeholders.
HVISKE_MODEL_ID=syvai/hviske-v3-conversation

# Logging (DEBUG, INFO, WARNING, ERROR).
LOG_LEVEL=INFO
