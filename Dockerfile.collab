# Live co-editing service for Workspace Docs (apps/collab).
#
# It runs its TypeScript sources with tsx and imports the editor schema from
# @multica/views, so the image carries the workspace sources it reaches plus
# their production dependencies, installed from the repository root.

# --- Dependencies + sources ---
# Same pinned Node as Dockerfile.web; bump them together.
FROM node:22.23.4-alpine AS deps

WORKDIR /app

COPY pnpm-lock.yaml pnpm-workspace.yaml package.json .npmrc ./
# Root pnpm patchedDependencies is read even without the mobile workspace.
COPY apps/mobile/patches/ apps/mobile/patches/
COPY patches/ patches/
COPY apps/collab/package.json apps/collab/
COPY packages/views/package.json packages/views/
COPY packages/core/package.json packages/core/
COPY packages/ui/package.json packages/ui/

RUN corepack enable && \
    PNPM_VERSION="$(node -p 'require("./package.json").packageManager')" && \
    corepack prepare "$PNPM_VERSION" --activate
RUN pnpm install --frozen-lockfile --prod --filter "@multica/collab..."

COPY apps/collab/ apps/collab/
COPY packages/views/ packages/views/
COPY packages/core/ packages/core/
COPY packages/ui/ packages/ui/

# --- Runtime ---
FROM node:22.23.4-alpine AS runner

# Alpine openssl security fixes (CVE-2026-63073, CVE-2026-75803).
# Remove once the pinned node image includes libssl3 >= 3.5.8-r0.
RUN apk add --no-cache "libcrypto3>=3.5.8-r0" "libssl3>=3.5.8-r0"

ENV NODE_ENV=production
ENV COLLAB_PORT=8095

WORKDIR /app
COPY --from=deps /app ./
# Ship the license and attribution notices with the image (LICENSE condition 1b)
COPY LICENSE NOTICE ./

USER node
WORKDIR /app/apps/collab

EXPOSE 8095

# One process, so SIGTERM reaches the handler that stores open docs.
CMD ["node", "--import", "tsx", "src/index.ts"]
