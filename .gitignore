node_modules
dist
*.log
.DS_Store
.envrc

# build outputs
.turbo
.next
# Written by next dev / build / typegen, with paths that differ between them.
next-env.d.ts
out
build
bin
dist-electron
storybook-static
*.tsbuildinfo
# ...except electron-builder's source resources dir, which holds tracked
# config files (entitlements, icons) — not build output.
!apps/desktop/build/
!apps/desktop/build/**

# env
.env*
!.env.example
# Desktop production config is public (backend URL, etc.) — track it so
# `pnpm package` produces a release-ready build without extra setup.
!apps/desktop/.env.production
# Staging URLs are internal and stay out of the repo. Only the templates are
# tracked; copy one to .env.staging locally.
!apps/desktop/.env.staging.example
!apps/mobile/.env.staging.example
# Mobile production config is public (production API URL) — track it so
# external users can run `pnpm ios:mobile:device:prod:release` against
# multica.ai's production backend without copying templates first.
!apps/mobile/.env.production

# test coverage
coverage

