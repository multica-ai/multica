# Dependencies
node_modules
.pnpm-store

# Build outputs
.next
dist
server/bin
server/tmp

# Git
.git
.gitignore

# Environment
.env
.env.*
!.env.example

# IDE
.idea
.vscode
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Test
e2e/test-results
coverage

# Docs
/docs/
*.md

# Only the web workspace is used by Dockerfile.web. Default-exclude future
# app workspaces so they do not silently enter the build context.
/apps/*
!/apps/web/

# Repository-only tooling
/.github/
/deploy/
# Docker can't re-include a file whose parent directory is excluded, so
# scripts/ is excluded file-by-file (via *) rather than as a whole directory
# — docker/agentrunner-runtime/Dockerfile COPYs smoke-test-agentrunner.sh
# into /opt/agentfarm/scripts/ and needs it to stay in the build context.
/scripts/*
!/scripts/smoke-test-agentrunner.sh
