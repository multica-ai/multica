+    /// Whether a worker for `key` is still in the office: a worker that has
+    /// been ended stays until it has walked out of the door.
+    pub fn issue_present(&self, key: &str) -> bool {
+        let id = AgentId::from_parts(pixtuoid_core::source::claude_code::SOURCE_NAME, key);
+        self.scene.agents.contains_key(&id)
+    }
+
+    /// The worker for `key` works (`true`) or sits idle (`false`).
+    pub fn issue_working(&mut self, key: &str, working: bool) {
+        let Some(now) = self.last_now else {
+            return;
+        };
+        let id = AgentId::from_parts(pixtuoid_core::source::claude_code::SOURCE_NAME, key);
+        if !self.scene.agents.contains_key(&id) {
+            return;
+        }
+        let tool_use_id = Some(format!("issue:{key}"));
+        let event = if working {
+            AgentEvent::ToolUseStart {
+                agent_id: id,
+                tool_use_id,
+                detail: None,
+            }
+        } else {
+            AgentEvent::ToolUseEnd {
+                agent_id: id,
+                tool_use_id,
+            }
+        };
+        self.reducer.apply(&mut self.scene, event, now, Transport::Hook);
+    }
+
+    /// The worker for `key` leaves its desk.
+    pub fn issue_end(&mut self, key: &str) {
+        let Some(now) = self.last_now else {
+            return;
+        };
+        let id = AgentId::from_parts(pixtuoid_core::source::claude_code::SOURCE_NAME, key);
+        self.issue_keys.remove(&id);
+        if !self.scene.agents.contains_key(&id) {
+            return;
+        }
+        let event = AgentEvent::SessionEnd {
+            agent_id: id,
+            as_child: false,
+        };
+        self.reducer.apply(&mut self.scene, event, now, Transport::Hook);
+    }
