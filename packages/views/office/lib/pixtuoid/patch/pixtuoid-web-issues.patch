+// Hashed by hand: the pixel grid is the bulk of a window, and hashing each cell's
+// `Option<Rgb>` as a separate value costs several hasher calls a cell. One word per
+// cell hashes the same content, and a window is fingerprinted every frame.
+impl std::hash::Hash for WindowView {
+    fn hash<H: std::hash::Hasher>(&self, state: &mut H) {
+        self.bay.hash(state);
+        self.top.hash(state);
+        self.h.hash(state);
+        self.glass_box.hash(state);
+        self.d.hash(state);
+        state.write_usize(self.px.len());
+        for cell in &self.px {
+            let word = match cell {
+                None => 0u32,
+                Some(c) => 1 << 24 | u32::from(c.r) << 16 | u32::from(c.g) << 8 | u32::from(c.b),
+            };
+            state.write_u32(word);
+        }
+    }
+}
