+/// The studio office's desk cap. A cap of 16 is the classic floor's count, so the
+/// studio asks for one more and lays out its own 16 desks, four rooms of four.
+pub const OFFICE_DESKS: usize = 17;
+/// The studio office's desk rooms, in a 2x2 grid.
+pub const OFFICE_ROOMS: u32 = 4;
+/// The desks in each of those rooms.
+pub const OFFICE_ROOM_DESKS: usize = 4;
+const _: () = assert!(OFFICE_DESKS == OFFICE_ROOMS as usize * OFFICE_ROOM_DESKS + 1);
+
+static DESK_CAP: std::sync::atomic::AtomicUsize = std::sync::atomic::AtomicUsize::new(0);
+
+/// Caps every floor's desks from now on (`None` lifts it): the web page sets the studio
+/// floor's count once, before it lays out anything.
+pub fn set_desk_cap(cap: Option<usize>) {
+    DESK_CAP.store(cap.unwrap_or(0), std::sync::atomic::Ordering::Relaxed);
+}
+
+static SEATED_ONLY: std::sync::atomic::AtomicBool = std::sync::atomic::AtomicBool::new(false);
+
+/// Keeps every worker at its desk (`true`) instead of letting idle ones wander to a break
+/// area: the web page sets it once, before it seats anyone.
+pub fn set_seated_only(seated: bool) {
+    SEATED_ONLY.store(seated, std::sync::atomic::Ordering::Relaxed);
+}
+
+pub(crate) fn seated_only() -> bool {
+    SEATED_ONLY.load(std::sync::atomic::Ordering::Relaxed)
+}
+
+fn desk_cap() -> Option<usize> {
+    match DESK_CAP.load(std::sync::atomic::Ordering::Relaxed) {
+        0 => None,
+        n => Some(n),
+    }
+}
