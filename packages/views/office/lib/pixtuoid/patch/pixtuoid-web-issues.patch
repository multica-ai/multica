+        PodDecorItem { kind: PodDecor::StaffDesk, pos: Point { x: room.x + staff_dx, y: staff_y } },
+        PodDecorItem { kind: PodDecor::StaffDesk, pos: Point { x: room.x + room.width - staff_dx, y: staff_y } },
+        // By the west wall, clear of the doorway cut in the south wall.
+        PodDecorItem {
+            kind: PodDecor::ReceptionSofa,
+            pos: Point { x: room.x + SOFA_FROM_WEST, y: room.y + room.height - SOFA_FROM_SOUTH },
+        },
+    ]
