+/// Copies only the `rects` of `buf` into `rgba`, which already mirrors `buf` everywhere else. Alpha is
+/// left alone: a whole expansion set it.
+fn expand_rects(rgba: &mut [u8], buf: &pixtuoid_core::sprite::RgbBuffer, rects: &[pixtuoid_scene::layout::Bounds]) {
+    let stride = usize::from(buf.width());
+    let rows = usize::from(buf.height());
+    let px = buf.as_slice();
+    for b in rects {
+        let x0 = usize::from(b.x).min(stride);
+        let x1 = (x0 + usize::from(b.width)).min(stride);
+        let y0 = usize::from(b.y).min(rows);
+        let y1 = (y0 + usize::from(b.height)).min(rows);
+        for y in y0..y1 {
+            for x in x0..x1 {
+                let c = px[y * stride + x];
+                let i = (y * stride + x) * 4;
+                rgba[i] = c.r;
+                rgba[i + 1] = c.g;
+                rgba[i + 2] = c.b;
+            }
+        }
+    }
+}
