+/// The studio floor's desk count: six desk rooms of ten desks each, in a 3x2 grid.
+pub(crate) const STUDIO_DESKS: usize = STUDIO_GRID_COLS as usize
+    * STUDIO_GRID_ROWS as usize
+    * STUDIO_POD_COLS as usize
+    * STUDIO_POD_ROWS as usize;
+const _: () = assert!(STUDIO_DESKS == crate::floor::OFFICE_ROOMS as usize * crate::floor::OFFICE_ROOM_DESKS);
+/// The desk rooms' grid: 3 across, 2 down.
+const STUDIO_GRID_COLS: u16 = 3;
+const STUDIO_GRID_ROWS: u16 = 2;
+/// The pod of desks in each room: 5 across, 2 down.
+const STUDIO_POD_COLS: u16 = 5;
+const STUDIO_POD_ROWS: u16 = 2;
+/// The smallest buffer the studio floor lays out in: the page's own minimum.
+/// The width holds the three rooms and the left column; the height is the two
+/// rows of rooms, the lounge above them and the corridor below.
+const STUDIO_MIN_W: u16 = 416;
+const STUDIO_MIN_H: u16 = 171;
+/// The studio's left column, narrower than the standard floor's so the desk rooms have the width.
+const STUDIO_MID_X_PCT: u16 = 20;
+/// A desk room's interior, walls to walls: a 5x2 pod and its aisles.
+const STUDIO_ROOM_W: u16 = 100;
+const STUDIO_ROOM_H: u16 = 44;
+const STUDIO_ROOM_GAP_X: u16 = 8;
+const STUDIO_ROOM_GAP_Y: u16 = 8;
+/// How far below the wall band the rooms start, clear of the lounge's couch.
+const STUDIO_ROOMS_BELOW_TOP: u16 = 10;
+/// The corridor left between the rooms' south doors and the floor's bottom edge: the
+/// grid is centred between the lounge and this corridor, so a tall floor keeps the
+/// doors open.
+const STUDIO_CORRIDOR_BELOW: u16 = 12;
+/// The desks of a room's pod are this far apart, edge to edge. Both steps (desk plus gap)
+/// are multiples of the coarse cell, so every desk in a row sits on the same grid cells.
+const STUDIO_POD_GAP_X: u16 = 10;
+const STUDIO_POD_GAP_Y: u16 = 10;
+const _: () = assert!((DESK_W + STUDIO_POD_GAP_X).is_multiple_of(COARSE_CELL_SIZE));
+const _: () = assert!((DESK_H + STUDIO_POD_GAP_Y).is_multiple_of(COARSE_CELL_SIZE));
+const _: () = assert!((STUDIO_ROOM_W + STUDIO_ROOM_GAP_X).is_multiple_of(COARSE_CELL_SIZE));
+const _: () = assert!((STUDIO_ROOM_H + STUDIO_ROOM_GAP_Y).is_multiple_of(COARSE_CELL_SIZE));
+/// The pod's first row sits this far below its room's north wall.
+const STUDIO_POD_TOP: u16 = 8;
+
+/// Rounds `v` down to the coarse grid the walkable mask routes on, so the studio's
+/// rooms and desks sit on its cells and a desk's approach is never half a cell.
+fn snap_to_coarse(v: u16) -> u16 {
+    v - v % COARSE_CELL_SIZE
+}
+
+/// The six desk rooms in a 3x2 grid centred in the band, in desk order: west to east,
+/// top row first. The grid sits between the lounge and the floor's bottom edge, with a
+/// corridor below it for the rooms' south doors.
+fn studio_rooms(band: &Bounds, top_margin: u16, buf_h: u16) -> Vec<Bounds> {
+    let total_w = STUDIO_GRID_COLS * STUDIO_ROOM_W + (STUDIO_GRID_COLS - 1) * STUDIO_ROOM_GAP_X;
+    let grid_h = STUDIO_GRID_ROWS * STUDIO_ROOM_H + (STUDIO_GRID_ROWS - 1) * STUDIO_ROOM_GAP_Y;
+    let x0 = snap_to_coarse(band.x + band.width.saturating_sub(total_w) / 2);
+    let top = top_margin + STUDIO_ROOMS_BELOW_TOP;
+    let floor_end = buf_h.saturating_sub(STUDIO_CORRIDOR_BELOW);
+    let y0 = snap_to_coarse(top + floor_end.saturating_sub(top + grid_h) / 2);
+    let mut rooms = Vec::with_capacity(STUDIO_GRID_COLS as usize * STUDIO_GRID_ROWS as usize);
+    for row in 0..STUDIO_GRID_ROWS {
+        for col in 0..STUDIO_GRID_COLS {
+            rooms.push(Bounds {
+                x: x0 + col * (STUDIO_ROOM_W + STUDIO_ROOM_GAP_X),
+                y: y0 + row * (STUDIO_ROOM_H + STUDIO_ROOM_GAP_Y),
+                width: STUDIO_ROOM_W,
+                height: STUDIO_ROOM_H,
+            });
+        }
+    }
+    rooms
+}
+
+/// The studio's sixty desks: a 5x2 pod centred in each desk room, all facing south in
+/// the pod's first row and north in its second, room by room.
+fn studio_desks(plan: &FloorPlan) -> Vec<HomeDesk> {
+    let mut desks = Vec::with_capacity(STUDIO_DESKS);
+    for room in &plan.desk_rooms {
+        let pod_w = STUDIO_POD_COLS * DESK_W + (STUDIO_POD_COLS - 1) * STUDIO_POD_GAP_X;
+        let ox = room.x + snap_to_coarse(room.width.saturating_sub(pod_w) / 2);
+        let oy = room.y + STUDIO_POD_TOP;
+        for r in 0..STUDIO_POD_ROWS {
+            for c in 0..STUDIO_POD_COLS {
+                desks.push(HomeDesk {
+                    at: Point {
+                        x: ox + c * (DESK_W + STUDIO_POD_GAP_X),
+                        y: oy + r * (DESK_H + STUDIO_POD_GAP_Y),
+                    },
+                    facing: pod_row_facing(r),
+                });
+            }
+        }
+    }
+    desks
+}
