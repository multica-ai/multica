{
  "extends": ["//"],
  "tasks": {
    "test": {
      "inputs": [
        "$TURBO_DEFAULT$",
        // common/theme-anchors, theme-variables and safe-area scan the app
        // sources that consume views; embed-tokens and theme-variables keep
        // docs/theming.md generated.
        "$TURBO_ROOT$/apps/desktop/src/renderer/**/*.{ts,tsx,css}",
        "$TURBO_ROOT$/apps/web/app/**/*.{ts,tsx}",
        "$TURBO_ROOT$/apps/web/components/**/*.{ts,tsx}",
        "$TURBO_ROOT$/docs/theming.md",
        // locales/copy-hygiene.test.ts holds the EE locale files to the same rules.
        "$TURBO_ROOT$/packages/ee/project-folders/locales/*.json",
        // rich-content/package-exports.test.ts checks every workspace's export
        // targets; ee's are the only ones outside views' dependencies.
        "$TURBO_ROOT$/apps/*/package.json",
        "$TURBO_ROOT$/packages/*/package.json",
        "$TURBO_ROOT$/packages/ee/index.ts"
      ]
    }
  }
}
