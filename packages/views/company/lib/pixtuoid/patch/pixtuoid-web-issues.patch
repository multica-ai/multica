+/// The width holds the three rooms and the left column; the height is the two
+/// rows of rooms, the lounge above them and the corridor below.
+const STUDIO_MIN_W: u16 = 416;
+const STUDIO_MIN_H: u16 = 171;
+/// The studio's left column, narrower than the standard floor's so the desk rooms have the width.
+const STUDIO_MID_X_PCT: u16 = 20;
+/// A desk room's interior, walls to walls: a 5x2 pod and its aisles.
+const STUDIO_ROOM_W: u16 = 100;
+const STUDIO_ROOM_H: u16 = 44;
+const STUDIO_ROOM_GAP_X: u16 = 8;
+const STUDIO_ROOM_GAP_Y: u16 = 8;
+/// How far below the wall band the rooms start, clear of the lounge's couch.
+const STUDIO_ROOMS_BELOW_TOP: u16 = 10;
+/// The corridor left between the rooms' south doors and the floor's bottom edge: the
+/// grid is centred between the lounge and this corridor, so a tall floor keeps the
+/// doors open.
+const STUDIO_CORRIDOR_BELOW: u16 = 12;
+/// The desks of a room's pod are this far apart, edge to edge. Both steps (desk plus gap)
+/// are multiples of the coarse cell, so every desk in a row sits on the same grid cells.
+const STUDIO_POD_GAP_X: u16 = 10;
+const STUDIO_POD_GAP_Y: u16 = 10;
+const _: () = assert!((DESK_W + STUDIO_POD_GAP_X).is_multiple_of(COARSE_CELL_SIZE));
+const _: () = assert!((DESK_H + STUDIO_POD_GAP_Y).is_multiple_of(COARSE_CELL_SIZE));
+const _: () = assert!((STUDIO_ROOM_W + STUDIO_ROOM_GAP_X).is_multiple_of(COARSE_CELL_SIZE));
+const _: () = assert!((STUDIO_ROOM_H + STUDIO_ROOM_GAP_Y).is_multiple_of(COARSE_CELL_SIZE));
+/// The pod's first row sits this far below its room's north wall.
+const STUDIO_POD_TOP: u16 = 8;
