+#[test]
+fn every_studio_desk_is_reachable_from_the_door() {
+    use crate::layout::{Facing, Furniture, approach_point, desk_walk_anchor_facing};
+    for (w, h) in [(416u16, 171u16), (416, 234), (480, 270), (500, 200), (570, 321)] {
+        let l = SceneLayout::compute_with_seed(w, h, Some(crate::floor::OFFICE_DESKS), 2)
+            .expect("the studio fits");
+        // Sixty desks in six rooms, and the boss seat after them.
+        assert_eq!(l.home_desks.len(), 61, "{w}x{h}");
+        assert_eq!(l.desk_rooms.len(), 6, "{w}x{h}");
+        // Rooms and desks sit on the coarse routing grid the walkable mask routes on.
+        for room in &l.desk_rooms {
+            assert_eq!(room.x % 4, 0, "{w}x{h}: room {room:?} off the coarse grid");
+            assert_eq!(room.y % 4, 0, "{w}x{h}: room {room:?} off the coarse grid");
+        }
+        for (i, desk) in l.home_desks.iter().enumerate().take(60) {
+            let room = l.desk_rooms[i / 10];
+            assert!(
+                desk.at.x >= room.x
+                    && desk.at.x + 10 <= room.x + room.width
+                    && desk.at.y >= room.y
+                    && desk.at.y + 6 <= room.y + room.height,
+                "{w}x{h}: desk {i} {:?} is outside room {room:?}",
+                desk.at
+            );
+            assert_eq!(desk.at.x % 4, 0, "{w}x{h}: desk {i} off the coarse grid");
+            assert_eq!(desk.at.y % 4, 0, "{w}x{h}: desk {i} off the coarse grid");
+        }
+        for &crate::layout::HomeDesk { at: desk, facing } in &l.home_desks {
+            let chair = desk_walk_anchor_facing(desk, facing);
+            let origin = match facing {
+                Facing::North => Point { x: chair.x, y: chair.y.saturating_add(40) },
+                _ => Point { x: chair.x, y: chair.y.saturating_sub(40) },
+            };
+            let a = approach_point(
+                Furniture::Desk,
+                chair,
+                facing,
+                l.pantry_counter_size(),
+                &l.walkable,
+                origin,
+                &l.reachable,
+            );
+            assert_ne!(a, chair, "{w}x{h}: desk {desk:?} ({facing:?}) has no reachable approach");
+            assert!(
+                l.reachable.reaches(a),
+                "{w}x{h}: desk {desk:?}: approach {a:?} must be A*-reachable"
+            );
+        }
+        // The door is on the open floor: every room door leads to the reachable set.
+        for room in &l.desk_rooms {
+            let below = Point { x: room.x + room.width / 2, y: room.y + room.height + 2 };
+            assert!(l.reachable.reaches(below), "{w}x{h}: the door of {room:?} is cut off");
+        }
+    }
+}
