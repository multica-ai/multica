{
  "name": "@tutti-os/ui-system",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "sideEffects": [
    "./src/styles/*.css",
    "./dist/styles/*.css",
    "./dist/styles.css"
  ],
  "imports": {
    "#components/*": "./src/components/*/index.tsx",
    "#icons/*": "./src/icons/*.tsx",
    "#lib/*": "./src/lib/*.ts"
  },
  "exports": {
    ".": "./src/index.ts",
    "./components": "./src/components/index.ts",
    "./date-format": "./src/lib/date-format.ts",
    "./dev-vite": "./src/dev-vite.ts",
    "./icons": "./src/icons/index.ts",
    "./metadata": "./src/metadata/index.ts",
    "./native": "./src/native/index.ts",
    "./native.css": {
      "types": "./src/styles/native.css.d.ts",
      "default": "./src/styles/native.css"
    },
    "./styles.css": "./src/styles/index.css",
    "./utils": "./src/lib/utils.ts",
    "./portal-container": "./src/lib/portal-container.ts"
  },
  "files": [
    "dist",
    "agent",
    "AGENTS.md",
    "NOTICE",
    "ui-system.md",
    "README.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tutti-os/tutti.git",
    "directory": "packages/ui/system"
  },
  "dependencies": {
    "@dnd-kit/core": "6.3.1",
    "@dnd-kit/modifiers": "9.0.0",
    "@dnd-kit/sortable": "10.0.0",
    "@dnd-kit/utilities": "3.2.2",
    "@fontsource-variable/lexend": "5.2.11",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "radix-ui": "1.4.3",
    "react-resizable-panels": "4.11.1",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "vaul": "1.1.2",
    "ws": "8.21.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "peerDependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "peerDependenciesMeta": {
    "react-dom": {
      "optional": true
    }
  },
  "tutti": {
    "tailwindSourceRoot": "src"
  },
  "devDependencies": {
    "@types/react": "19.2.15",
    "@types/react-dom": "19.2.3",
    "@types/ws": "8.18.1"
  }
}
